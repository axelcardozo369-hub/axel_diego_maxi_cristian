# Copiá este archivo como .env y completá con tus datos.
# NUNCA subas el .env a GitHub ni compartas las claves: si se exponen, revocalas.
PORT=3000

DB_NAME=bugbuster
DB_USER=root
DB_PASS=
DB_HOST=localhost
DB_PORT=3306

# true = Sequelize agrega columnas nuevas a las tablas al iniciar.
# Usalo UNA vez después de actualizar el código y volvé a false.
DB_SYNC_ALTER=false

JWT_SECRET=cambiar-por-un-secreto-largo
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# ---------- Archivos ----------
UPLOADS_DIR=uploads

# ---------- IA (opcional) ----------
# El sistema funciona SIN IA: lee CSV, JSON, Excel, Word y PDF con texto
# localmente y responde reportes con el motor local. La IA mejora las
# descripciones y redacta las respuestas; si falla, se usa el motor local.
#
# auto       = Gemini → OpenRouter → motor local (recomendado)
# gemini     = solo Gemini (+ motor local)
# openrouter = solo OpenRouter (+ motor local)
# simulado   = respuestas de ejemplo, sin internet (para demos)
# ninguno    = solo motor local
IA_PROVEEDOR=auto

# Google Gemini — clave gratis en https://aistudio.google.com/apikey
# Podés poner VARIOS modelos separados por coma: si el primero se queda sin
# cuota, se usa el siguiente. Los límites de tu proyecto se ven en AI Studio.
GEMINI_API_KEY=tu_clave_aqui
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.8-flash
GEMINI_BASE_URL=

# OpenRouter — clave en https://openrouter.ai/keys
# openrouter/free elige solo un modelo gratuito. Plan gratis: 20 pedidos por
# minuto y 50 por día (sin créditos comprados). Solo trabaja con texto.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=InfoHub
